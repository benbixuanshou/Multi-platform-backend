# Backend
SECRET_KEY=change-me-to-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# MySQL
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=comment_platform
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Milvus
MILVUS_HOST=milvus
MILVUS_PORT=19530

# LLM API (ModelProvider)
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-change-me
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_CLASSIFY_MODEL=deepseek-chat
LLM_REPLY_MODEL=deepseek-reasoner
LLM_INSIGHT_MODEL=deepseek-reasoner

# Embedding
EMBEDDING_API_KEY=sk-change-me
